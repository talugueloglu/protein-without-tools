# ==============================================================================
# Proteins Without Tools — Optional API Configuration
# Copy to `.env` when ready to run live LLM API calls (`cp .env.example .env`).
# Dataset verification, offline grading, and unit tests work WITHOUT API keys.
# ==============================================================================

# 1. OpenAI API (for gpt-6.1-sol, gpt-6.2-sol, gpt-6.2-astra)
OPENAI_API_KEY=

# 2. Anthropic Direct API (optional)
ANTHROPIC_API_KEY=

# 3. Google Gemini API (for gemini frontier reasoning)
GEMINI_API_KEY=

# 4. OpenRouter (optional single-key fallback for DeepSeek, Qwen, GPT, Gemini, etc.)
OPENROUTER_API_KEY=

# 5. Safety & Budget Controls
MAX_USD_BUDGET=25.00
ASSERT_NO_SILENT_FALLBACK=1
