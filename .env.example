# ==============================================================================
# Fable-Protein-Bench — Optional API Configuration
# Copy to `.env` when ready to run live LLM API calls (`cp .env.example .env`).
# Stage 1 dataset curation, offline verification, prompt export (for web UI or
# Batch APIs), and 3D grading work completely WITHOUT any API keys.
# ==============================================================================

# 1. Anthropic Direct API (for claude-fable-5-2 and claude-opus-5-5)
ANTHROPIC_API_KEY=

# 2. OpenAI API (for gpt-5.2)
OPENAI_API_KEY=

# 3. Google Gemini API (for gemini frontier reasoning)
GEMINI_API_KEY=

# 4. OpenRouter (optional single-key fallback for DeepSeek, Qwen, GPT, Gemini, etc.)
OPENROUTER_API_KEY=

# 5. Safety & Budget Controls
MAX_USD_BUDGET=25.00
ASSERT_NO_SILENT_FALLBACK=1
